{
  "name": "docket-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "migrate": "tsx --env-file=.env src/migrate.ts",
    "seed": "tsx --env-file=.env src/seed.ts",
    "typecheck": "tsc --noEmit",
    "seed:demo": "tsx --env-file=.env src/seed-demo.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "fastify": "^5.12.7",
    "firebase-admin": "^14.5.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
